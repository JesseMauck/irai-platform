# ── Platform ─────────────────────────────────────────────────────────
# SQLite for local dev; PostgreSQL in production. Supabase: paste the Session pooler URI as-is
# (postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres).
# DATABASE_URL=postgresql://irai:irai@localhost:5432/irai
DATABASE_URL=sqlite:///./irai.db
IRAI_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
IRAI_CORS_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:3000

# Market data: live = Yahoo Finance (+ SEC EDGAR in ValueBot); demo = fictional, no network
IRAI_MARKET_MODE=live
IRAI_DEMO_FALLBACK=1          # if the live feed fails, show demo data labelled DEMO
IRAI_QUOTE_TTL=30             # seconds
IRAI_INFO_TTL=21600           # fundamentals cache, seconds
IRAI_LEADERBOARD_MIN_TRADES=20

# ── Email (outbox delivered by the worker; without SMTP_HOST mail is logged) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Irradiance <no-reply@irradiance.ai>"
IRAI_WORKER_INTERVAL=60
IRAI_RATE_LIMIT=1
LOG_LEVEL=INFO

# ── Billing: Square (without SQUARE_ACCESS_TOKEN checkout activates plans directly, for dev) ──
SQUARE_ENVIRONMENT=sandbox            # sandbox | production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=                   # python -m app.payments.setup_square --locations
SQUARE_WEBHOOK_SIGNATURE_KEY=         # from the webhook subscription in the Square Developer Dashboard
SQUARE_WEBHOOK_URL=https://api.irradiance.ai/api/billing/webhook/square   # must match the subscription exactly
SQUARE_PLAN_ESSENTIAL_MONTHLY=        # printed by: python -m app.payments.setup_square
SQUARE_PLAN_ESSENTIAL_ANNUAL=
SQUARE_PLAN_PRO_MONTHLY=
SQUARE_PLAN_PRO_ANNUAL=

# ── ValueBot ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # enables AI thesis, research, story→numbers, report writing
SEC_USER_AGENT="Your Name you@yourdomain.com"   # required by the SEC
VALUEBOT_MAX_WORKERS=4
VALUEBOT_SNAPSHOT_TTL=900
# VALUEBOT_MODEL=claude-opus-5-5
# VALUEBOT_FAST_MODEL=claude-sonnet-5-5
# VALUEBOT_ERP=0.0423
# VALUEBOT_DATA_DIR=./runs
