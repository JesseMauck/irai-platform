# ── Platform ─────────────────────────────────────────────────────────
# SQLite for local dev; PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://irai:irai@localhost:5432/irai
DATABASE_URL=sqlite:///./irai.db
IRAI_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
IRAI_CORS_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:3000

# Market data: live = Yahoo Finance (+ SEC EDGAR in ValueBot); demo = fictional, no network
IRAI_MARKET_MODE=live
IRAI_DEMO_FALLBACK=1          # if the live feed fails, show demo data labelled DEMO
IRAI_QUOTE_TTL=30             # seconds
IRAI_INFO_TTL=21600           # fundamentals cache, seconds
IRAI_LEADERBOARD_MIN_TRADES=20

# ── Billing (optional; without a key checkout starts trials directly) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# ── ValueBot ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # enables AI thesis, research, story→numbers, report writing
SEC_USER_AGENT="Your Name you@yourdomain.com"   # required by the SEC
VALUEBOT_MAX_WORKERS=4
VALUEBOT_SNAPSHOT_TTL=900
# VALUEBOT_MODEL=claude-opus-5-5
# VALUEBOT_FAST_MODEL=claude-sonnet-5-5
# VALUEBOT_ERP=0.0423
# VALUEBOT_DATA_DIR=./runs
